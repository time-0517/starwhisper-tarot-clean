@model 占卜.ViewModels.TarotAnalysisViewModel
@{
    ViewData["Title"] = "占卜解析";
}

<style>
    html, body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Noto Sans TC', sans-serif;
        color: #fdf4ff;
        background: transparent; /* ⬅ 關鍵 */
    }


    .analysis-page {
        max-width: 1100px;
        margin: 40px auto 60px;
        padding: 24px 30px 40px;
        border-radius: 20px;
        background: rgba(5, 2, 18, 0.9);
        box-shadow: 0 0 30px rgba(0,0,0,0.9);
        backdrop-filter: blur(4px);
    }

    h2 {
        text-align: center;
        margin-top: 24px;
        margin-bottom: 10px;
        font-size: 38px;
        letter-spacing: 6px;
        text-shadow: 0 0 18px rgba(0,0,0,0.8);
    }

    .analysis-subtitle {
        text-align: center;
        font-size: 14px;
        opacity: 0.8;
        margin-bottom: 26px;
    }

    /* ===== 問題區塊 ===== */
    .question-block {
        padding: 18px 20px;
        border-radius: 16px;
        background: radial-gradient(circle at top left,#3b286a,#170b2a);
        border: 1px solid rgba(255,255,255,0.18);
        margin-bottom: 22px;
    }

    .question-title {
        font-size: 16px;
        letter-spacing: 3px;
        margin-bottom: 6px;
        opacity: 0.9;
    }

    .question-text {
        font-size: 15px;
        line-height: 1.7;
    }

    .mode-tag {
        margin-top: 10px;
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        letter-spacing: 2px;
        background: rgba(255,255,255,0.1);
        opacity: 0.9;
    }

    /* ===== 總結區塊 ===== */
    .summary-block {
        margin-top: 24px;
        padding: 18px 20px 16px;
        border-radius: 16px;
        background: radial-gradient(circle at top,#4a2b6a,#1a0b23);
        border: 1px solid rgba(253,160,133,0.7);
        box-shadow: 0 0 20px rgba(253,160,133,0.7);
    }

    .summary-title {
        font-size: 16px;
        letter-spacing: 3px;
        margin-bottom: 8px;
    }

    .summary-text {
        font-size: 15px;
        line-height: 1.9;
    }

    /* ===== 卡片列表 ===== */
    .cards-section {
        margin-top: 28px;
    }

    .cards-title {
        font-size: 16px;
        letter-spacing: 3px;
        margin-bottom: 16px;
        opacity: 0.9;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    @@media (max-width: 960px) {
        .cards-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 720px) {
        .cards-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .card-panel {
        position: relative;
        padding: 14px 14px 16px;
        border-radius: 16px;
        background: radial-gradient(circle at top,#2b2048,#11091f);
        border: 1px solid rgba(255,255,255,0.14);
        box-shadow: 0 8px 18px rgba(0,0,0,0.9);
    }

        .card-panel.reversed {
            border-style: dashed;
            border-color: rgba(255,210,170,0.8);
        }

    .card-position {
        position: absolute;
        right: 12px;
        top: 10px;
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 999px;
        background: rgba(255,255,255,0.08);
        letter-spacing: 2px;
    }

    .card-img-wrap {
        width: 100%;
        max-width: 180px;
        margin: 0 auto 10px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(0,0,0,0.9);
    }

        .card-img-wrap img {
            width: 100%;
            display: block;
        }

    .card-panel.reversed .card-img-wrap img {
        transform: rotate(180deg);
    }

    .card-name-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 4px;
        margin-bottom: 6px;
    }

    .card-name {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 3px;
        text-align: center;
    }

    .orientation-tag {
        font-size: 12px;
        padding: 2px 10px;
        border-radius: 999px;
        letter-spacing: 2px;
    }

    .card-panel:not(.reversed) .orientation-tag {
        background: rgba(246,211,101,0.18);
        border: 1px solid rgba(246,211,101,0.9);
        color: #f6d365;
    }

    .card-panel.reversed .orientation-tag {
        background: rgba(180,120,255,0.18);
        border: 1px solid rgba(180,120,255,0.9);
        color: #c9a6ff;
    }


    .card-keywords {
        font-size: 13px;
        opacity: 0.9;
        line-height: 1.6;
        margin-bottom: 6px;
    }

    .card-ai-title {
        font-size: 13px;
        letter-spacing: 2px;
        opacity: 0.95;
        margin: 8px 0 4px;
    }

    .card-ai-text {
        font-size: 13px;
        line-height: 1.8;
        opacity: 0.92;
        white-space: pre-line;
    }

    /* ===== 底部按鈕 ===== */
    .analysis-actions {
        margin-top: 28px;
        text-align: center;
    }

    .btn-primary {
        border: none;
        border-radius: 999px;
        padding: 9px 24px;
        font-size: 14px;
        letter-spacing: 2px;
        cursor: pointer;
        background: linear-gradient(90deg,#f6d365,#fda085);
        color: #241323;
        box-shadow: 0 0 18px rgba(253,160,133,0.65);
        text-decoration: none;
        display: inline-block;
        margin: 0 6px;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 22px rgba(253,160,133,0.9);
        }

    .btn-secondary {
        border-radius: 999px;
        padding: 8px 20px;
        border: 1px solid rgba(255,255,255,0.35);
        background: transparent;
        color: #fdf4ff;
        font-size: 14px;
        letter-spacing: 2px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin: 0 6px;
    }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.08);
        }

    /* 小小呼吸光暈 */
    .summary-block {
        position: relative;
        overflow: hidden;
    }

        .summary-block::before {
            content: "";
            position: absolute;
            inset: -40%;
            background: radial-gradient(circle at 30% 0%, rgba(255,255,255,0.16), transparent 60%);
            opacity: 0.6;
            pointer-events: none;
            mix-blend-mode: screen;
            animation: glowBreath 6s ease-in-out infinite;
        }

    @@keyframes glowBreath {
        0%, 100% {
            opacity: 0.3;
            transform: translateX(-10%) scale(1);
        }

        50% {
            opacity: 0.9;
            transform: translateX(8%) scale(1.05);
        }
    }


    .tarot-summary,
    .tarot-cards {
        margin: 2rem 0;
    }

    .section-title {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        color: #e6c07b;
        letter-spacing: 1px;
    }

    .tarot-paragraph {
        line-height: 1.9;
        margin-bottom: 1rem;
        color: #f0e9ff;
    }

    .tarot-card-reading {
        background: rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 1.2rem;
        margin-bottom: 1.5rem;
    }

    .card-title {
        font-size: 1.1rem;
        margin-bottom: .6rem;
        color: #ffd369;
    }

    .tarot-detail {
        line-height: 1.8;
        color: #f5f3ff;
    }

    .divination-divider {
        position: relative;
        height: 1px;
        margin: 32px 0 28px;
        background: linear-gradient( to right, transparent, rgba(246, 211, 101, 0.6), transparent );
    }

        .divination-divider::after {
            content: "✦ ✧ ✦";
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(5, 2, 18, 0.9);
            padding: 0 12px;
            font-size: 14px;
            letter-spacing: 6px;
            color: #f6d365;
        }

    .summary-subtitle {
        font-size: 13px;
        opacity: 0.75;
        margin-bottom: 10px;
        letter-spacing: 2px;
    }

    .card-panel {
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

        .card-panel:hover {
            transform: translateY(-6px) scale(1.01);
            box-shadow: 0 14px 30px rgba(0,0,0,0.85);
        }

    .summary-block {
        animation: fadeUp 0.8s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-panel.future {
        border-style: dashed;
        border-color: rgba(246, 211, 101, 0.85); /* 溫柔金色 */
        box-shadow: 0 0 18px rgba(246, 211, 101, 0.35);
    }

    .card-panel {
        border: 1.5px dashed rgba(246, 211, 101, 0.85);
        box-shadow: 0 0 18px rgba(246, 211, 101, 0.35);
    }

    .card-panel {
        border: 1.5px dashed rgba(246, 211, 101, 0.85);
    }

        .card-panel.reversed {
            border-color: rgba(180, 120, 255, 0.9);
        }
    /* ===============================
       🔮 占卜解析｜最終儀式標題
       =============================== */

    .analysis-title {
        position: relative;
        text-align: center;
        margin: 36px 0 12px;
        font-size: 40px;
        font-weight: 500;
        letter-spacing: 8px;
        color: transparent;
        background: linear-gradient( 180deg, #ffffff 0%, #f6d365 40%, #c9a6ff 70%, #ffffff 100% );
        background-clip: text;
        -webkit-background-clip: text;
        text-shadow: 0 0 8px rgba(246,211,101,0.25), 0 0 18px rgba(180,120,255,0.18);
    }

        /* 🌙 低調的命運光暈（不再過亮） */
        .analysis-title::before {
            content: "";
            position: absolute;
            left: 50%;
            top: 55%;
            width: 420px;
            height: 120px;
            transform: translate(-50%, -50%);
            background: radial-gradient( ellipse at center, rgba(246,211,101,0.18), rgba(180,120,255,0.14), transparent 70% );
            filter: blur(40px);
            z-index: -1;
        }

        /* ⭐ 標題下方的細儀式線 */
        .analysis-title::after {
            content: "✦ ✧ ✦";
            display: block;
            margin-top: 14px;
            font-size: 13px;
            letter-spacing: 10px;
            color: #f6d365;
            opacity: 0.75;
        }

    /* 副標：更柔、更像低語 */
    .analysis-subtitle {
        text-align: center;
        font-size: 13px;
        letter-spacing: 2px;
        opacity: 0.75;
        margin-bottom: 30px;
        color: #e3d9ff;
    }


</style>

<h2>占卜解析</h2>
<div class="analysis-subtitle">
    下面是根據你本次問題與抽到的牌，所整理出的解讀結果。
</div>

<div class="analysis-page">
    <!-- ===== 問題 & 牌陣 ===== -->
    <section class="question-block">
        <div class="question-title">你這次詢問的問題</div>
        <div class="question-text">
            @Html.Raw(Html.Encode(Model?.Question ?? "（未提供問題）"))
        </div>

        <div class="mode-tag">
            @{
                string modeText = Model?.Mode switch
                {
                    "single" => "牌陣：單張指引",
                    "timeline" => "牌陣：三張牌・時間線（過去／現在／未來）",
                    "relationship" => "牌陣：三張牌・關係解析（自己／對方／關係走向）",
                    _ => $"牌陣：{Model?.Mode ?? "未知"}"
                };
            }
            @modeText
        </div>
    </section>

    <div class="divination-divider"></div>

    @if (!string.IsNullOrWhiteSpace(Model?.AiSummary))
    {
        // ===== 解法 2：在 View 剝掉 JSON 外殼 =====
        var summaryText = Model.AiSummary;

        if (summaryText.TrimStart().StartsWith("{") &&
        summaryText.Contains("\"summary\""))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(summaryText);
                if (doc.RootElement.TryGetProperty("summary", out var s))
                {
                    summaryText = s.GetString();
                }
            }
            catch
            {
                // JSON 解析失敗就維持原樣
            }
        }

        <section class="summary-block">
            <div class="summary-title">整體訊息總結</div>

            <div class="summary-subtitle">
                請靜下心來，感受牌所帶來的訊息
            </div>

            <div class="summary-text">
                @Html.Raw(Html.Encode(summaryText ?? "").Replace("\n", "<br />"))
            </div>
        </section>

    }




    <!-- ===== 單張牌解析 ===== -->
    @if (Model?.Cards != null && Model.Cards.Any())
    {
        <section class="cards-section">
            <div class="cards-title">各張牌帶給你的提醒</div>

            <div class="cards-grid">
                @foreach (var card in Model.Cards)
                {
                    var isFuture = card.Position == "未來";

                    var isReversed = string.Equals(card.Orientation, "reversed", System.StringComparison.OrdinalIgnoreCase);
                    <article class="card-panel
            @(isReversed ? "reversed" : "")
            @(isFuture ? "future" : "")">

                        @* 位置標籤（過去 / 現在 / 未來 / 自己 / 對方 / 走向 / 指引） *@
                        @if (!string.IsNullOrWhiteSpace(card.Position))
                        {
                            <div class="card-position">@card.Position</div>
                        }

                        <div class="card-img-wrap">
                            <img src="@Url.Content("~/images/" + (card.ImageName ?? "placeholder.png"))"
                                 alt="@card.Name" />
                        </div>

                        <div class="card-name-row">
                            <div class="card-name">@card.Name</div>
                            <span class="orientation-tag">
                                @(isReversed ? "逆位" : "正位")
                            </span>
                        </div>

                        @* 關鍵字（如果有的話） *@
                        @if (!string.IsNullOrWhiteSpace(card.KeywordsUp) ||
                                        !string.IsNullOrWhiteSpace(card.KeywordsRev))
                        {
                            <div class="card-keywords">
                                @{
                                    var kw = isReversed
                                    ? (card.KeywordsRev ?? card.KeywordsUp)
                                    : (card.KeywordsUp ?? card.KeywordsRev);
                                }
                                <strong>關鍵字：</strong>@kw
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(card.AiDetail))
                        {
                            <div class="card-ai-title">這張牌在本次牌陣中的意義</div>
                            <div class="card-ai-text">
                                @Html.Raw(Html.Encode(card.AiDetail).Replace("\n", "<br />"))
                            </div>
                        }
                    </article>
                }
            </div>
        </section>
    }

    <!-- ===== 底部操作 ===== -->
    <div class="analysis-actions">
        <a asp-controller="Tarot"
           asp-action="DrawCards"
           class="btn-secondary">
            再抽一次
        </a>

        <a asp-controller="Tarot"
           asp-action="History"
           class="btn-primary">
            查看抽牌歷史紀錄
        </a>
    </div>
</div>
