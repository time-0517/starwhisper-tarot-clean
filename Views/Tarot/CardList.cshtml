            opacity: 1;
            transform: translateX(12px);
            box-shadow: 0 0 20px rgba(255, 210, 150, 0.9);
        }

    /* 開啟詳解視窗時，把整個畫面的大漣漪關掉，避免變成一整片光幕 */
    body.modal-open .bg-ripple-layer {
        opacity: 0;
        pointer-events: none;
    }

    /* 覺得背景星星太亮也可以順便調暗（想保留就用 0.4，不喜歡就改 0）*/
    body.modal-open .starry-layer {
        opacity: 0.4;
    }

    /* 滑鼠固定頻率水波紋（跟著滑鼠走） */
    .mouse-ripple {
        position: fixed;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        pointer-events: none;
        border: 2px solid rgba(255,255,255,0.55);
        box-shadow: 0 0 12px rgba(255,255,255,0.8);
        transform: translate(-50%, -50%) scale(0.2);
        opacity: 1;
        z-index: 9999;
        /* 先不要固定綁動畫，讓 JS 用 class 觸發 */
        animation: none;
    }

        /* 只有加上 .playing 的時候才跑水波紋動畫 */
        .mouse-ripple.playing {
            animation: rippleFixed 1s ease-out forwards;
        }

    @@keyframes rippleFixed {
        0% {
            transform: translate(-50%, -50%) scale(0.2);
            opacity: 1;
        }

        60% {
            opacity: 0.7;
        }

        100% {
            transform: translate(-50%, -50%) scale(3);
