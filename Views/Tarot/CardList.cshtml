    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("cardModal");
        const modalImg = document.getElementById("modalCardImage");
     const cardWrap = document.querySelector(".modal-card-wrap");
    const particles = document.querySelector(".card-particles");

        const closeBtn = document.querySelector(".card-modal-close");
        const backdrop = document.querySelector(".card-modal-backdrop");

        const descEl = document.getElementById("modalDesc");
        const extraEl = document.getElementById("modalExtra");

        // ⭐ 產生星星噴射（2 秒消失）
               function spawnCardStars() {
        if (!particles) return;

        particles.innerHTML = "";

        const starCount = 26; // 想更爆炸就調大
        for (let i = 0; i < starCount; i++) {
            const star = document.createElement("div");
            star.className = "card-star";

            // 從四邊附近出生（-5% ~ 105%），看起來在卡片外圈
            const side = Math.floor(Math.random() * 4);
            let x, y;

            if (side === 0) {         // 上
                x = Math.random() * 100;
                y = -5;
            } else if (side === 1) {  // 右
                x = 105;
                y = Math.random() * 100;
            } else if (side === 2) {  // 下
                x = Math.random() * 100;
                y = 105;
            } else {                  // 左
                x = -5;
                y = Math.random() * 100;
            }

            star.style.left = x + "%";
            star.style.top = y + "%";

            // 往外噴射一小段距離
            const angle = Math.random() * Math.PI * 2;
            const dist = 60 + Math.random() * 80; // 60~140px
            const tx = Math.cos(angle) * dist;
            const ty = Math.sin(angle) * dist;

            star.style.setProperty("--tx", tx + "px");
            star.style.setProperty("--ty", ty + "px");

            const delay = Math.random() * 0.15;
            star.style.animation = `cardStarBurst 2s ease-out ${delay}s forwards`;

            particles.appendChild(star);

            star.addEventListener("animationend", () => {
                star.remove();
            });
        }
    }


        // 綁定每一張牌的「介紹」按鈕
        document.querySelectorAll(".info-button").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();

                const imgSrc = btn.getAttribute("data-img");
                const cardName = btn.getAttribute("data-name") || "";
                const descText = btn.getAttribute("data-desc") || "";
                const extraText = getExtraForCard(cardName); // ⭐ 先算好額外說明

                if (imgSrc) {
                    modalImg.src = imgSrc;
                }

               // ⭐ 用打字機顯示牌義 & 額外指引
            typeText(descEl, descText, 26, () => {
                // 第一段打完再開始第二段
                typeText(extraEl, extraText, 26);
            });

                // 牌名動畫
                animateCardName(cardName);

                // 打開 modal + 卡片淡入
                document.body.classList.add("modal-open");   // ⭐ 新增這行
        modal.classList.add("show");
        cardWrap.classList.remove("reveal");
        void cardWrap.offsetWidth;
        cardWrap.classList.add("reveal");

                // ⭐ 這裡觸發星星噴射
                spawnCardStars();
            });
        });

            function closeModal() {
        modal.classList.remove("show");
        document.body.classList.remove("modal-open"); // ⭐ 加這行

        // ⭐ 若想關掉就清空打字內容，可加這兩行
    descEl.textContent = "";
    extraEl.textContent = "";
    }

        closeBtn.addEventListener("click", closeModal);
        backdrop.addEventListener("click", closeModal);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeModal();
        });
    });
</script>

<script>
        function animateCardName(text) {
        const nameBox = document.getElementById("modalCardName");
        nameBox.innerHTML = "";
        nameBox.style.opacity = 0;

        setTimeout(() => {
            nameBox.style.opacity = 1;

            [...text].forEach((char, i) => {
                const span = document.createElement("span");
                span.textContent = char;
                span.style.opacity = "0";
                span.style.display = "inline-block";
                span.style.transform = "translateY(12px)";
                span.style.transition = "opacity 0.35s ease, transform 0.35s ease";

                nameBox.appendChild(span);

                setTimeout(() => {
                    span.style.opacity = "1";
                    span.style.transform = "translateY(0)";
                }, i * 120);  // 每字間隔 0.12 秒
            });
        }, 500); // 延遲 0.5 秒才開始打字效果
    }

</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // 建立背景漣漪容器（只建立一次）
        const rippleLayer = document.createElement("div");
        rippleLayer.className = "bg-ripple-layer";
        document.body.appendChild(rippleLayer);

        function spawnRipple() {
            const ripple = document.createElement("div");
            ripple.className = "bg-ripple";

            const vw = window.innerWidth;
            const vh = window.innerHeight;

            // 隨機位置（整個視窗）
            const x = Math.random() * vw;
            const y = Math.random() * vh;

            // 隨機尺寸（很大一圈）
            const size = 500 + Math.random() * 600; // 500~1100px

            ripple.style.left = x + "px";
            ripple.style.top = y + "px";
            ripple.style.setProperty("--size", size + "px");

            rippleLayer.appendChild(ripple);

            // 動畫結束後移除 DOM，避免越累越多
            ripple.addEventListener("animationend", () => {
                ripple.remove();
            });

            // 下一圈漣漪的時間（2~4秒之間）
            const nextDelay = 2000 + Math.random() * 2000;
            setTimeout(spawnRipple, nextDelay);
        }

        // 啟動第一個漣漪
        spawnRipple();
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const layer = document.getElementById("starryLayer");
        if (!layer) return;

        const starCount = 90; // 想更誇張可以改 150、200

        // 一般星星
        for (let i = 0; i < starCount; i++) {
