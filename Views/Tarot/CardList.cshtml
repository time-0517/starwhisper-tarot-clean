

@model List<占卜.Models.TarotCard>

@{
    ViewData["Title"] = "塔羅牌全圖鑑";
}

<style>
    body {
        background: radial-gradient(circle at center, #0d0b22, #05030f, #000);
        background-size: cover;
        color: white;
        font-family: 'Noto Sans TC', sans-serif;
        overflow-x: hidden;
        position: relative;
    }

        /* 星空粒子（柔和版）*/
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            background-image: radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,0.55), transparent), radial-gradient(2px 2px at 70% 80%, rgba(180,150,255,0.55), transparent), radial-gradient(2px 2px at 40% 60%, rgba(150,200,255,0.55), transparent), radial-gradient(1.5px 1.5px at 85% 10%, rgba(255,200,255,0.55), transparent);
            opacity: 0.55;
            animation: starFloat 12s linear infinite;
        }

    @@keyframes starFloat {
        from {
            transform: translateY(0px);
        }

        to {
            transform: translateY(-30px);
        }
    }

    /* ======= 標題 ======= */
    h2 {
        text-align: center;
        margin-top: 25px;
        font-size: 48px;
        letter-spacing: 8px;
        background: linear-gradient(90deg, #f3d9ff, #d5e1ff, #e8c7ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: titleGlow 4s ease-in-out infinite;
    }

    @@keyframes titleGlow {
        0%, 100% {
            text-shadow: 0 0 12px rgba(255,255,255,0.4);
        }

        50% {
            text-shadow: 0 0 38px rgba(210,160,255,1);
        }
    }

    /* ======================
            ⭐ 一行六張牌
    ====================== */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* ⭐ 改成六張 */
        gap: 26px;
        padding: 40px 80px;
    }

    /* ====== 卡牌 ====== */
    .card-item {
        width: 100%;
        aspect-ratio: 2/3;
        perspective: 1200px;
        position: relative;
    }

    /* ==== 翻牌容器 ==== */
    .card-inner {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.2s ease;
        cursor: pointer;
        opacity: 0;
        transform: rotateY(0deg); /* 初始背面 */
    }

    /* ====== 浮空動態效果 ====== */
    .card-item {
        position: relative;
        transform-style: preserve-3d;
    }


    /* ===== 卡片底部名稱（漸層） ===== */
    .card-label {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 24%; /* 底部大約 1/4 高度做漸層 */
        pointer-events: none; /* 不影響點擊卡片 */
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 6px;
        opacity: 0; /* 一開始看不到 */
        transform: translateY(8px); /* 微微往下藏起來 */
        transition: opacity 0.5s ease, transform 0.5s ease;
        z-index: 3;
    }

        /* 漸層背景 */
        .card-label::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
        }

        /* 文字本身 */
        .card-label span {
            position: relative;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 4px;
            color: #ffffff;
            text-shadow: 0 0 6px rgba(0,0,0,0.9);
        }

    /* 等全部翻完 → body 會被加上 .cards-ready，這時名稱才浮現 */
    body.cards-ready .card-label {
        opacity: 1;
        transform: translateY(0);
    }

    /* 滑鼠移到卡片上時，名稱隱藏（給 hover 區塊讓位） */
    .card-item:hover .card-label {
        opacity: 0;
        transform: translateY(10px);
        transition-delay: 0s;
    }





    /* 每張卡片有自己的浮動動畫 */
    @@keyframes floatUpDown {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0px);
        }

        position: relative;
    }

        /* 星空粒子（柔和版）*/
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            background-image: radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,0.55), transparent), radial-gradient(2px 2px at 70% 80%, rgba(180,150,255,0.55), transparent), radial-gradient(2px 2px at 40% 60%, rgba(150,200,255,0.55), transparent), radial-gradient(1.5px 1.5px at 85% 10%, rgba(255,200,255,0.55), transparent);
            opacity: 0.55;
            animation: starFloat 12s linear infinite;
        }

    @@keyframes starFloat {
        from {
            transform: translateY(0px);
        }

        to {
            transform: translateY(-30px);
        }
    }

    /* ======= 標題 ======= */
    h2 {
        text-align: center;
        margin-top: 25px;
        font-size: 48px;
        letter-spacing: 8px;
        background: linear-gradient(90deg, #f3d9ff, #d5e1ff, #e8c7ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: titleGlow 4s ease-in-out infinite;
    }

    @@keyframes titleGlow {
        0%, 100% {
            text-shadow: 0 0 12px rgba(255,255,255,0.4);
        }

        50% {
            text-shadow: 0 0 38px rgba(210,160,255,1);
        }
    }

    /* ======================
            ⭐ 一行六張牌
    ====================== */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* ⭐ 改成六張 */
        gap: 26px;
        padding: 40px 80px;
    }

    /* ====== 卡牌 ====== */
    .card-item {
        width: 100%;
        aspect-ratio: 2/3;
        perspective: 1200px;
        position: relative;
    }

    /* ==== 翻牌容器 ==== */
    .card-inner {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 1s ease;
        cursor: pointer;
        opacity: 0;
        transform: rotateY(0deg); /* 初始背面 */
    }

        /* ⭐ 翻面 → 正面朝上 */
        .card-inner.show {
            opacity: 1;
            transform: rotateY(180deg);
        }

    /* 卡片兩面 */
    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 0 18px rgba(200,160,255,0.35);
    }

    /* 背面 */
    .card-back {
        transform: rotateY(0deg);
        background: url('/images/CardBacks.jpg') center/cover;
    }

    /* 正面 */
    .card-front {
        transform: rotateY(180deg);
    }

        .card-front img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* hover 光暈加強 */
    .card-item:hover .card-inner {
        transform: rotateY(180deg) scale(1.06);
        box-shadow: 0 0 32px rgba(220,180,255,0.85);
    }

    /* ============================
       ⭐ 卡牌 hover：霧化 + 正逆位文字浮現
       ============================ */

    .card-item {
        position: relative;
        overflow: visible;
    }

    /* 正逆位文字容器 */
    .card-hover-info {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px; /* 上下間距，避免互相卡住 */
        text-align: center;
        opacity: 0;
        transition: opacity 0.35s ease;
        z-index: 5;
    }

    /* 正位（上方） */
    .upright-text {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 12px;
        color: #f8eaff;
        text-shadow: 0 0 14px rgba(200,170,255,0.8);
        transform: translateY(0);
    }

    /* 逆位（下方） */
    .reversed-text {
        font-size: 18px;
        font-weight: 600;
        margin-top: 12px;
        color: #d6c7ff;
        opacity: 0.85;
        text-shadow: 0 0 10px rgba(100,80,150,0.7);
        transform: translateY(0);
    }

    /* ⭐ 滑鼠移到卡片：文字浮現 */
    .card-item:hover .card-hover-info {
        opacity: 1;
        transition-delay: 0.5s;
    }

    /* ⭐ 霧化效果（套在卡面上） */
    .card-item:hover .card-inner {
        filter: blur(4px) brightness(0.75);
        transform: scale(0.94);
        transition: filter 0.4s ease, transform 0.4s ease;
    }

    /* 防止 hover 影響翻牌動畫 */
    .card-inner.show {
        filter: none;
    }

    /* === 菱形按鈕（介紹） === */
    .info-button {
        position: relative;
        width: 150px; /* 想更扁就改大一點，例如 180px */
        height: 80px;
        pointer-events: auto;
        opacity: 1; /* 顯示與否由 .card-hover-info 控制 */
        overflow: visible;
        z-index: 10; /* 確定在卡片霧化層上面 */
    }

        .info-button span {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            z-index: 30;
        }

    /* hover 時出現按鈕（延遲 0.5 秒） */
    .card-item:hover .info-button {
        opacity: 1;
        transition-delay: 0.5s;
        pointer-events: auto;
    }


   
    .info-diamond {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%; /* 填滿 info-button */
        height: auto;
        filter: drop-shadow(0 0 8px rgba(0,0,0,0.9)) drop-shadow(0 0 10px rgba(255,255,255,0.9)); /* 邊更銳利 + 發光 */
    }

        /* === 滑鼠移到菱形時的水波紋效果 === */
        .info-button:hover {
            cursor: pointer;
        }

        .info-button:hover .info-diamond {
            animation: diamondRipple 0.9s ease-out infinite;
        }

    /* 滑鼠移到菱形上時啟動水波紋動畫 */
    .info-button:hover::after {
        animation: diamondRipple 1.2s ease-out infinite;
    }

    /* 菱形往外擴散 & 消失 */
    @@keyframes diamondRipple {
        0% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
        }

        100% {
            transform: translate(-50%, -50%) scale(1.4);
            opacity: 0;
        }
    }

   

    /* === 卡片翻面後才顯示介紹按鈕 === */
    

    .card-item:hover .card-hover-overlay {
        opacity: 1;
        transition-delay: 0.5s;
    }

    .card-hover-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }


    /* =========================
       ⭐ 詳細介紹 Modal 視窗
       ========================= */
    .card-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

        .card-modal.show {
            display: flex;
        }

    .card-modal-backdrop {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(40, 20, 80, 0.9), rgba(0, 0, 0, 0.97));
        backdrop-filter: blur(4px);
    }

    .card-modal-content {
        position: relative;
        display: flex;
        width: min(900px, 90vw);
        max-height: 80vh;
        border-radius: 20px;
        padding: 24px 30px;
        background: rgba(10, 5, 25, 0.95);
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
        gap: 24px;
        z-index: 1;
    }

    .card-modal-close {
        position: absolute;
        top: 10px;
        right: 16px;
        border: none;
        background: transparent;
        color: #fdf4ff;
        font-size: 26px;
        cursor: pointer;
        padding: 4px 8px;
        line-height: 1;
    }

        .card-modal-close:hover {
            transform: scale(1.15);
        }

    .card-modal-left {
        flex: 0 0 260px;
        display: flex;
        flex-direction: column; /* ⭐ 改成垂直排列 */
        align-items: center;
        justify-content: flex-start; /* 讓上方靠緊一點 */
    }


    /* 外殼：決定卡片大小，讓星星可以飛出邊界 */
    .modal-card-shell {
        position: relative;
        width: 260px;
        height: 420px;
    }

    /* 內層：只放卡片 + 掃光，這層才 overflow: hidden */
    .modal-card-wrap {
        position: absolute;
        inset: 0;
        overflow: hidden; /* ✅ 光幕被卡片框住 */
        background: transparent;
    }



        /* 卡片本體：真的那張牌 */
        .modal-card-wrap img {
            position: relative;
            z-index: 1; /* 在特效上層 */
            width: 100%;
            height: 100%;
            border-radius: 20px; /* 把圓角改到圖片本身 */
            object-fit: cover;
            opacity: 0;
            filter: blur(10px) brightness(0.6);
            transform: scale(1.05);
            box-shadow: 0 18px 38px rgba(0,0,0,0.8);
        }

        .modal-card-wrap.reveal img {
            animation: modalFadeInSoft 0.7s ease-out forwards;
        }

       


    /* 打開時啟動魔法陣動畫 */
    

    /* 斜向光束：保留原本效果 */
    .modal-card-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( 120deg, rgba(255,255,255,0) 10%, rgba(255,255,255,0.9) 50%, rgba(255,255,255,0) 90% );
        mix-blend-mode: screen;
        opacity: 0;
        transform: translateX(-130%);
        pointer-events: none;
        z-index: 2; /* 在牌上面掃過去 */
    }

    .modal-card-wrap.reveal::after {
        animation: shineSweep 0.8s ease-out 0.1s forwards;
    }


    /* 開啟時才轉一圈、然後淡出 */
    
    /* 右側：內文區（牌義 & 指引） */
    .card-modal-right {
        flex: 1;
        color: #f5e9ff;
        padding-inline: 12px;
        padding-top: 6px;
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
    }

    .modal-text {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .modal-section-title {
        margin: 0 0 6px;
        font-size: 19px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #ffeafc;
    }

    .modal-section p {
        margin: 0;
        line-height: 1.7;
        font-size: 15px;
        opacity: 0.92;
        white-space: pre-wrap; /* 如果 Description 有換行，可以保留 */
    }

        /* 打字中時加的游標 */
        .modal-section p.typing::after {
            content: "▌";
            margin-left: 3px;
            animation: caretBlink 1s steps(1, end) infinite;
        }

    @@keyframes caretBlink {
        0%, 50% {
            opacity: 1;
        }

        51%, 100% {
            opacity: 0;
        }
    }




       

        .modal-card-wrap.reveal img {
            animation: modalFadeInSoft 0.7s ease-out forwards;
        }

        

    /* 卡牌名稱容器 */
    .modal-card-name {
        margin-top: 16px;
        text-align: center;
        font-size: 22px;
        letter-spacing: 4px;
        color: #f8ecff;
        font-weight: 700;
        min-height: 1.5em; /* 沒文字時也不會跳動 */
    }

        /* 每一個字元的動畫樣式 */
        .modal-card-name span {
            display: inline-block;
            opacity: 0;
            transform: translateY(10px);
            filter: blur(4px);
            /* 0.5 秒之後才開始，然後依照索引一個一個接續出現 */
            animation: cardNameCharIn 0.35s ease-out forwards;
            animation-delay: calc(0.5s + var(--char-index) * 0.07s);
        }

    /* 星星單顆造型 */
    .card-star {
        position: absolute;
        width: 6px;
        height: 6px;
        background: radial-gradient(circle, #fff, rgba(255,255,255,0.3));
        border-radius: 50%;
        pointer-events: none;
        opacity: 1;
        transform: scale(1);
    }

    /* 裝星星的容器（放在大張牌的上面） */
    .card-particles {
        position: absolute;
        inset: -10%; /* 稍微比卡片大一點，讓星星從邊邊噴出去 */
        overflow: visible;
        pointer-events: none;
        z-index: 3; /* 在卡片上面、文字下面都可以 */
    }

    @@keyframes cardStarBurst {
        0% {
            opacity: 1;
            transform: translate(0, 0) scale(1);
        }

        100% {
            opacity: 0;
            transform: translate(var(--tx), var(--ty)) scale(0.2);
        }
    }


    /* 逐字浮現的 keyframes */
    @@keyframes cardNameCharIn {
        0% {
            opacity: 0;
            transform: translateY(10px);
            filter: blur(4px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }
    

    /* 卡片柔和淡入 */
    @@keyframes modalFadeInSoft {
        0% {
            opacity: 0;
            filter: blur(10px) brightness(0.5);
            transform: scale(1.05);
        }

        60% {
            opacity: 1;
            filter: blur(3px) brightness(1.1);
            transform: scale(1.02);
        }

        100% {
            opacity: 1;
            filter: blur(0) brightness(1);
            transform: scale(1);
        }
    }

    /* 光束掃過 */
    @@keyframes shineSweep {
        0% {
            opacity: 0;
            transform: translateX(-130%);
        }

        20% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            transform: translateX(130%);
        }
    }

    /* =========================
       ⭐ 全畫面背景漣漪
       ========================= */

    /* 放所有漣漪的容器（固定蓋滿整個畫面） */
    .bg-ripple-layer {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 1; /* 之後會把卡片設在 z-index:1 才不會被蓋住 */
    }

    /* 單個漣漪（大圓圈） */
    /* 單個漣漪容器：只負責定位 */
    .bg-ripple {
        position: absolute;
        left: 50%;
        top: 50%;
        width: var(--size, 600px);
        height: var(--size, 600px);
        transform: translate(-50%, -50%);
        pointer-events: none;
    }

        /* 外圈 + 內圈共用的基本樣式 */
        .bg-ripple::before,
        .bg-ripple::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.32);
            box-shadow: 0 0 25px rgba(255, 255, 255, 0.45), 0 0 90px rgba(200, 160, 255, 0.35);
            opacity: 0;
        }

        /* ⭐ 大圈（外圈） */
        .bg-ripple::before {
            animation: bgRippleOuter 5s ease-out forwards;
        }

        /* ⭐ 小圈（內圈） */
        .bg-ripple::after {
            inset: 10%; /* 讓內圈比外圈小一圈 */
            border-width: 1.5px;
            animation: bgRippleInner 4s ease-out forwards;
        }

    /* 外圈動畫：比較大、持續久一點 */
    @@keyframes bgRippleOuter {
        0% {
            opacity: 0.85;
            transform: scale(0.2);
        }

        60% {
            opacity: 0.6;
        }

        100% {
            opacity: 0;
            transform: scale(1.8);
        }
    }

    /* 內圈動畫：從中心冒出來，比較小一點 */
    @@keyframes bgRippleInner {
        0% {
            opacity: 0.9;
            transform: scale(0);
        }

        50% {
            opacity: 0.65;
        }

        100% {
            opacity: 0;
            transform: scale(1.4);
        }
    }


    /* 讓主內容浮在漣漪上方 */
    h2,
    .card-grid {
        position: relative;
        z-index: 2;
    }

    /* 把原本星空 background 放到更底層 */
    body::before {
        z-index: -1;
    }

    /* ============================
       ⭐ 深空繁星背景（新版）
    ============================ */

    .starry-layer {
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0; /* 在 body 背景上方、漣漪與卡片下方 */
    }

        /* 一般星星 */
        .starry-layer .star {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff, rgba(255,255,255,0));
            box-shadow: 0 0 10px rgba(255,255,255,0.9), 0 0 26px rgba(190,160,255,0.9);
            opacity: 0.6;
            animation: tarotStarTwinkle 4s ease-in-out infinite;
            transform-origin: center;
        }

    /* ⭐ 閃爍動畫 */
    @@keyframes tarotStarTwinkle {
        0% {
            opacity: 0.3;
            transform: scale(0.7);
        }

        50% {
            opacity: 1;
            transform: scale(1.4);
        }

        100% {
            opacity: 0.3;
            transform: scale(0.7);
        }
    }

    /* =========================
       ⭐ 左側分類標籤
       ========================= */
    .filter-sidebar {
        position: fixed;
        left: 32px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 12px;
        z-index: 3; /* 在星空 & 漣漪之上，卡牌之下也沒關係 */
    }

    .filter-tag {
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 14px;
        letter-spacing: 3px;
        color: #f8ecff;
        background: linear-gradient(90deg, #241b4a, #3a295f);
        box-shadow: 0 0 12px rgba(20, 10, 40, 0.9);
        cursor: pointer;
        opacity: 0.75;
        transform: translateX(0);
        transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease, background 0.22s ease;
        white-space: nowrap;
    }

        /* 滑鼠移上去：往右「冒出來一點」 */
        .filter-tag:hover {
            transform: translateX(8px);
            opacity: 1;
            box-shadow: 0 0 18px rgba(120, 100, 220, 0.9);
        }

        /* 被選中的分類 */
        .filter-tag.active {
            background: linear-gradient(90deg, #f6d365, #fda085);
