        // ⭐ 中央放一顆超大的 debug 星星，確認這層一定有顯示
        const debugStar = document.createElement("div");
        debugStar.className = "star-debug";
        layer.appendChild(debugStar);
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const filterTags = document.querySelectorAll(".filter-tag");
        const cardItems = document.querySelectorAll(".card-item");

        filterTags.forEach(tag => {
            tag.addEventListener("click", () => {
                const filter = tag.getAttribute("data-filter") || "all";

                // 切換 active 樣式
                filterTags.forEach(t => t.classList.remove("active"));
                tag.classList.add("active");

                // 依照 data-category 顯示 / 隱藏卡片
                cardItems.forEach(card => {
                    const cat = card.getAttribute("data-category");

                    if (filter === "all" || cat === filter) {
                        card.style.display = "";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;

        // 建立唯一一個跟著滑鼠走的水波紋元素
        const ripple = document.createElement("div");
        ripple.className = "mouse-ripple";
        document.body.appendChild(ripple);

        function updatePosition() {
            ripple.style.left = mouseX + "px";
            ripple.style.top = mouseY + "px";
        }

        // ⭐ 滑鼠移動時，更新座標 & 位置（讓水波紋黏在滑鼠上）
        window.addEventListener("mousemove", (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            updatePosition();
        });

        // 一開始先放在畫面中央或當前座標
        updatePosition();

        // ⭐ 每 1 秒觸發一次「水波紋動畫」
        setInterval(() => {
            // 滑鼠就算沒動，也同步一次位置
            updatePosition();

            // 重置動畫：先拿掉 class，再強制 reflow，最後再加回去
            ripple.classList.remove("playing");
            void ripple.offsetWidth;   // 這行讓瀏覽器重新計算，才能重新觸發動畫
            ripple.classList.add("playing");
        }, 5000); // 1 秒一次
    });
</script>
