    // 沒寫到的牌就用通用版
    function getExtraForCard(cardName) {
        if (tarotExtraMap[cardName]) {
            return tarotExtraMap[cardName];
        }
        return "這張牌此刻出現在你面前，代表它想提醒你：生活中那些反覆出現的念頭與情境，其實正是能帶你走向改變的入口。";
