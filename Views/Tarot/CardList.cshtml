<h2>塔羅牌全圖鑑</h2>
<!-- 左側分類標籤 -->
<div class="filter-sidebar">
    <div class="filter-tag active" data-filter="all">全部</div>
    <div class="filter-tag" data-filter="major">大阿爾克那</div>
    <div class="filter-tag" data-filter="wands">權杖</div>
    <div class="filter-tag" data-filter="cups">聖杯</div>
    <div class="filter-tag" data-filter="swords">寶劍</div>
    <div class="filter-tag" data-filter="pentacles">錢幣</div>
</div>


<div class="card-grid">
    @{
        int index = 0;
    }
    @foreach (var card in Model)
{
    
        var img = card.ImageName ?? "";
        string category;

        if (img.StartsWith("maj_", StringComparison.OrdinalIgnoreCase))
        {
            category = "major";        // 大阿爾克那
        }
        else if (img.StartsWith("Wands", StringComparison.OrdinalIgnoreCase))
        {
            category = "wands";        // 權杖
        }
        else if (img.StartsWith("Cups", StringComparison.OrdinalIgnoreCase))
        {
            category = "cups";         // 聖杯
        }
        else if (img.StartsWith("Swords", StringComparison.OrdinalIgnoreCase))
        {
            category = "swords";       // 寶劍
        }
        else if (img.StartsWith("Pentacles", StringComparison.OrdinalIgnoreCase))
        {
            category = "pentacles";    // 金幣 / 錢幣
        }
        else
        {
            category = "major";        // 找不到就先當大牌放
        }
    

    <div class="card-item" data-category="@category">
        <!-- 卡片前後面：照舊 -->
        <div class="card-inner">
            <div class="card-face card-back"></div>
            <div class="card-face card-front">
                <img src="~/images/@card.ImageName" alt="@card.Name" />
            </div>
        </div>

        <!-- 卡片下方標籤：顯示名稱 -->
        <div class="card-label">
            <span>@card.Name</span>
        </div>

        <!-- ⭐ hover 0.5 秒後出現的整個介紹區塊 -->
        <div class="card-hover-info">
            <div class="upright-text">正位：@card.KeywordsUp</div>

            <div class="info-button"
                 data-img="@Url.Content("~/images/" + card.ImageName)"
                 data-name="@card.Name"
                 data-desc="@card.Description">
                <img src="~/images/diamond-outline.svg" class="info-diamond" alt="介紹框" />
                <span>介紹</span>
            </div>

            <div class="reversed-text">逆位：@card.KeywordsRev</div>
        </div>
    </div>
}

</div>

<div class="starry-layer" id="starryLayer"></div>


<!-- ⭐ 詳細介紹 Modal -->
<div id="cardModal" class="card-modal">
    <div class="card-modal-backdrop"></div>

    <div class="card-modal-content">
        <button class="card-modal-close" type="button">✕</button>

        <div class="card-modal-left">
            <div class="modal-card-shell">
                <div class="modal-card-wrap">
                    <img id="modalCardImage" src="" alt="Tarot card">
                </div>
                <div class="card-particles"></div>
            </div>

            <!-- ⭐ 卡牌名稱：逐字浮現 -->
            <div class="modal-card-name" id="modalCardName"></div>
        </div>

        <!-- 右側：之後再放內文 -->
        <div class="card-modal-right">
            <div class="modal-text">
                <!-- 牌義說明（資料庫 Description） -->
                <div class="modal-section">
                    <h3 class="modal-section-title">牌義說明</h3>
                    <p id="modalDesc"></p>
                </div>

                <!-- 延伸指引（我們用 JS 幫你生一句更口語的說明） -->
                <div class="modal-section">
                    <p id="modalExtra"></p>
                </div>
            </div>
        </div>

    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(".card-inner");
        const items = document.querySelectorAll(".card-item");

         const interval = 50;        // 原本 120，可以再調 50、60 看感覺
    const flipDuration = 20;

        // ========= 依序翻牌 =========
        cards.forEach((card, i) => {
            const delay = i * 80; // 跟原本一樣的間隔
            setTimeout(() => {
                card.classList.add("show");
            }, delay);
        });

        // ========= 每張卡片浮空 & 隨機飄動 =========
        items.forEach((item) => {
            const floatHeight = Math.random() * 18;      // 0〜18px
            const floatSpeed = 3 + Math.random() * 3;    // 3〜6秒

            item.style.transform = `translateY(-${floatHeight}px)`;
            item.style.animation = `floatUpDown ${floatSpeed}s ease-in-out infinite`;
        });

        // ========= 等「全部翻完」再顯示卡片名稱 =========
    const totalTime = (cards.length - 1) * 80 + 500;


        setTimeout(() => {
            document.body.classList.add("cards-ready");
        }, totalTime);
    });
</script>


<script>
    // ⭐ 通用打字機：把文字一個字一個字打到 element 裡
    let typingSerial = 0; // 用來中止舊的打字動畫

    function typeText(el, text, speed = 28, done) {
        typingSerial++;
        const mySerial = typingSerial;

        el.classList.add("typing");
        el.textContent = "";
        let i = 0;

        function step() {
            // 如果期間又開了新的牌，就停止舊動畫
            if (mySerial !== typingSerial) return;

            if (i < text.length) {
                el.textContent += text.charAt(i);
                i++;
                setTimeout(step, speed);
            } else {
                el.classList.remove("typing");
                if (typeof done === "function") done();
            }
        }

        step();
    }
